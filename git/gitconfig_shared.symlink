[core]
	excludesfile = ~/.gitignore_global

# Aliases.
[alias]
	lg = log --branches --graph --pretty=format:'%C(yellow)%h %C(reset)%s%C(red)%d %C(blue)%an%C(reset), %C(cyan)%ar'
	tags = tag -l -n
	tag-release = "!f() { git tag -a \"$1\" -m \"Release $1\" ; }; f"
	ch = checkout
	sync = "!git fetch --all --prune && { [ \"$(git symbolic-ref --short -q HEAD)\" = main ] && git pull --ff-only || git fetch origin main:main ; } && gh poi"
	amend = "git commit --amend --no-edit"

# Use the right branch name when creating new repos
[init]
        defaultBranch = main

# Merge/pull/push
[merge]
	log = true
[push]
	default = current
[pull]
	rebase = true
[rebase]
  autoStash = true

# Colors.
[color]
	interactive = auto
	ui = auto
	pager = true
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan

# Diffing

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true
    syntax-theme = Monokai Extended

[merge]
    conflictstyle = zdiff3
