#!/bin/bash

set -e

DOTFILES="$HOME/dotfiles"

# Profiles pick which modules run. "mac" is the full setup; "devbox" is the
# subset that makes sense on a remote Linux devbox (whose provisioning, e.g.
# an Ansible playbook, clones this repo and runs `setup --profile devbox`).
PROFILE="mac"

MAC_MODULES=(homebrew zsh bin bat btop ghostty herdr launchagents claude agents)
DEVBOX_MODULES=(zsh bin bat btop herdr claude agents)

usage() {
  echo "Usage: setup [--profile mac|devbox]"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --profile)
      PROFILE="$2"
      shift 2
      ;;
    --profile=*)
      PROFILE="${1#*=}"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

case "$PROFILE" in
  mac)
    MODULES=("${MAC_MODULES[@]}")
    ;;
  devbox)
    MODULES=("${DEVBOX_MODULES[@]}")
    # The devbox profile runs unattended (Ansible, dotfiles-sync over SSH),
    # so install scripts must not prompt.
    export DOTFILES_NO_CONFIRMATION_PROMPT=true
    ;;
  *)
    echo "Unknown profile: $PROFILE" >&2
    usage >&2
    exit 1
    ;;
esac

source "$DOTFILES/lib.sh"

print_banner() {
  gum style \
    --foreground 212 --border-foreground 212 --border thick \
    --align center --width 50 --margin "1 0" --padding "1 2" \
    "🥑 Dotfiles setup" \
    "Profile: $PROFILE — OS: $(uname -s)"
}

# Yell when the profile doesn't match the OS: "mac" belongs on macOS, "devbox"
# on the Linux dev box. Continuing is allowed but needs explicit confirmation.
check_profile_matches_os() {
  local _os
  _os="$(uname -s)"

  case "$PROFILE:$_os" in
    mac:Darwin | devbox:Linux)
      return 0
      ;;
  esac

  gum style \
    --foreground 196 --border-foreground 196 --border thick \
    --align center --width 50 --margin "1 0" --padding "1 2" \
    "🚨 PROFILE/OS MISMATCH 🚨" \
    "You're running the '$PROFILE' profile on $_os." \
    "Use --profile mac on macOS" \
    "and --profile devbox on Linux."

  # gum confirm directly, not confirm(): the devbox profile auto-confirms
  # prompts, and a profile/OS mismatch must never be waved through silently.
  gum confirm "Continue with the '$PROFILE' profile anyway?" || fail "Aborting."
}

create_directories() {
  echo_info "Creating directories"

  for dir in "Code" "Writing" "bin" "tmp" ".ssh"; do
    local _path="$HOME/$dir"

    if [ -d "$_path" ]; then
      echo "Directory already exists: $_path"
    else
      mkdir -p "$_path" && echo "Directory created successfully: $_path"
    fi
  done
}

symlink_files() {
  local _files
  local _symlinked

  echo_info "Symlinking all files ending in '.symlink'"
  _files=$(find "$DOTFILES" -name '*.symlink')

  for abs_file in $_files; do
    _symlinked=".$(basename "${abs_file%.symlink}")"
    ln -sfv "$abs_file" "$HOME/$_symlinked"
  done
}

copy_example_files() {
  local _files
  local _dst

  echo_info "Copying all files ending in '.example'"
  _files=$(find "$DOTFILES" -name '*.example')

  for abs_file in $_files; do
    _dst="$HOME/.$(basename "${abs_file%.example}")"

    if [[ -s "$_dst" ]]; then
      echo "File $_dst exists and will not be overridden"
    else
      cp -v "$abs_file" "$_dst"
    fi
  done

  echo
}

run_install_scripts() {
  echo_info "Running install scripts ($PROFILE profile)"

  for module in "${MODULES[@]}"; do
    gum style "🏗️  Running $module/install.sh" --foreground 33 --bold
    echo
    bash "$DOTFILES/$module/install.sh"
    echo
  done
}

main() {
  ensure_gum_installed
  print_banner
  check_profile_matches_os
  create_directories
  symlink_files
  copy_example_files
  run_install_scripts

  gum style "🚀 Setup complete!" \
    --foreground 35 --bold \
    --margin "1 0" --padding "0 1" \
    --border "rounded" --border-foreground 35 \
    --width 50 --align center
}

main
